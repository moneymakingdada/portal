# Optional. Copy to .env.local to override.
# Product name shown across the UI (change together with APP_NAME in backend/.env).
VITE_APP_NAME=Portal
# Public API base URL shown in code samples. Defaults to the current site origin.
# VITE_PUBLIC_API_URL=https://api.example.com
# Shown on the Terms and Privacy pages. Anything left empty is simply not shown.
# VITE_COMPANY_NAME=Your Company Ltd
# VITE_SUPPORT_EMAIL=support@example.com
# VITE_COMPANY_ADDRESS=12 Example Street, Accra
# VITE_DPC_REGISTRATION=