# Copy to .env for local development:  cp .env.example .env
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_DEBUG=True
# Required when DJANGO_DEBUG is off. Use two different values.
DJANGO_SECRET_KEY=
OTP_HMAC_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (docker compose up -d starts one with these credentials)
DATABASE_URL=postgres://kodo:kodo@localhost:5432/kodo
REDIS_URL=redis://127.0.0.1:6379/0

# Branding used in SMS text. DEFAULT_SENDER_ID: letters/digits, max 11 characters.
APP_NAME=Portal
DEFAULT_SENDER_ID=Portal

# console = print SMS in the server log (development only) | arkesel = send for real
SMS_BACKEND=console
ARKESEL_API_KEY=
ARKESEL_SANDBOX=False

# Wallet top-ups through Paystack (https://dashboard.paystack.com/#/settings/developer).
# Paystack must also be given your webhook URL: https://YOUR-DOMAIN/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
# The address the React app is served from - Paystack sends people back here after paying.
FRONTEND_URL=http://localhost:5173
# Bounds for a custom top-up amount, in pesewas (100 = GHS 1).
TOPUP_MIN_PESEWAS=500
TOPUP_MAX_PESEWAS=1000000

# Welcome credit for new accounts, in pesewas (100 = GHS 1). 0 disables it.
SIGNUP_BONUS_PESEWAS=200
# Used when no PricingTier row exists (pesewas per message segment).
DEFAULT_PRICE_PER_SEGMENT_PESEWAS=5
# Ceiling on sign-up verification SMS per day.
SIGNUP_SMS_DAILY_CAP=1000
# Number of reverse proxies in front of Django (nginx = 1). Needed for correct per-IP limits.
TRUSTED_PROXY_COUNT=0

# Automatic birthday messages (see messaging/customers.py) run once a day via
# Celery beat: celery -A config beat -l info
# Nothing here to configure - toggle per account from the dashboard's
# Customers page, or Organization.birthday_messages_enabled in /admin.
